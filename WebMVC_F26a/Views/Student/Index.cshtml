@model IEnumerable<StudentModel>

@*
    The controller passes this view a collection of students. Model is the strongly typed
    data this page can use; the loop below creates one table row for each student.
*@
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    @* This link targets a Create action; the controller needs an action to handle that URL. *@
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @* DisplayNameFor uses the model property name or its display metadata as a heading. *@
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Credits)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @* DisplayFor renders each property's value from the current student. *@
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Credits)
            </td>
                <td>
                    @* These links target actions and include the selected student's id in the URL. *@
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                </td>
        </tr>
}
    </tbody>
</table>